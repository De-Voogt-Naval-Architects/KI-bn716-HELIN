{
  "container_template": {
    "HostConfig": {
      "Binds": [
        "/var/lib/helin/config/datalogger:/config:ro",
        "datalogger-extractor-state:/data/out"
      ]
    },
    "Cmd": [
      "--addr",
      "192.168.192.5:50052",
      "--signals",
      "/config/tags",
      "--loop",
      "--rate",
      "1000",
      "--dest-type",
      "http",
      "--dest-addr",
      "https://HelinDataCollector:6684/sensor-reading",
      "--insecure"
    ]
  },
  "environment_template": {},
  "configuration_template": {},
  "enabled": true
}
