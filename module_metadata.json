{
  "container_template": {
    "Cmd": [
      "--addr=DATALOGGER_HOST:50715",
      "--mode=follow",
      "--rate=1",
      "--interval=300",
      "--lag=60",
      "--backfill-minutes=60",
      "--keep-days=30"
    ],
    "HostConfig": {
      "Binds": [
        "datalogger-extractor-data:/data/out"
      ],
      "LogConfig": {
        "Type": "json-file",
        "Config": { "max-size": "10m", "max-file": "3" }
      }
    }
  },
  "environment_template": {},
  "configuration_template": {},
  "enabled": true
}
