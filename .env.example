# Copy to .env and fill in — .env is gitignored, never commit real values.

# M2M credentials for your Helin Platform instance
HELIN_CLIENT_ID=your-client-id
HELIN_CLIENT_SECRET=your-client-secret

# Base URL of your platform instance, e.g. https://acme.helinplatform.com
HELIN_INSTANCE=https://your-instance.example.com

# Dedicated private container registry of your instance
REGISTRY_URL=registry.your-instance.example.com
REGISTRY_USER=your-registry-user
REGISTRY_PASSWORD=your-registry-password
